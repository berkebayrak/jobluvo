# Neon Postgres. The pooled host serves the app; the direct host (same string
# without "-pooler") is used only by drizzle-kit for migrations.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# OpenAI. One model id per job so each can be routed and measured on its own.
OPENAI_API_KEY=
MODEL_EXTRACT=
MODEL_SCORE=
MODEL_TAILOR=

# Shared secret the cron routes require in the Authorization header.
CRON_SECRET=

# Batch sizes, sized for Vercel Hobby: 60 second functions, daily cron.
INGEST_BATCH=5
DETAIL_FETCH_BATCH=40
SCORE_BATCH=20
SCORE_CONCURRENCY=5
SIMILARITY_THRESHOLD=0.85
